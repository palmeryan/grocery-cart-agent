{
  "name": "whole-foods-cart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cart": "tsx src/cli.ts",
    "login": "bash scripts/open-profile.sh",
    "setup-extension-token": "bash scripts/setup-extension-token.sh",
    "auth-check": "tsx src/cli.ts auth-check",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/mcp": "0.0.80",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
