{
  "name": "whole-foods-cart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cart": "tsx src/cli.ts",
    "cart-list": "tsx src/cli.ts build",
    "cart-recipes": "tsx src/cli.ts build-recipes",
    "ingredients": "tsx src/cli.ts ingredients",
    "login": "bash scripts/open-profile.sh",
    "auth-check": "tsx src/cli.ts auth-check",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "playwright": "1.63.0-alpha-2026-08-31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
