{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runStatus",
    "verificationStatus",
    "requestSha256",
    "authenticated",
    "wholeFoodsStorefrontConfirmed",
    "baselineCartCount",
    "baselineItems",
    "finalCartCount",
    "finalCartDelta",
    "selections",
    "failureReason"
  ],
  "properties": {
    "runStatus": {
      "type": "string",
      "enum": ["completed", "partial", "failed"]
    },
    "verificationStatus": {
      "type": "string",
      "enum": ["confirmed", "inconclusive", "not_run"]
    },
    "requestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authenticated": { "type": "boolean" },
    "wholeFoodsStorefrontConfirmed": { "type": "boolean" },
    "baselineCartCount": { "type": "integer", "minimum": 0 },
    "baselineItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productName", "quantity"],
        "properties": {
          "productName": { "type": "string", "minLength": 1 },
          "productId": { "type": "string", "pattern": "^[A-Za-z0-9]{10}$" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "finalCartCount": { "type": "integer", "minimum": 0 },
    "finalCartDelta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productName", "quantity"],
        "properties": {
          "productName": { "type": "string", "minLength": 1 },
          "productId": { "type": "string", "pattern": "^[A-Za-z0-9]{10}$" },
          "quantity": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ingredientId",
          "requested",
          "status",
          "productName",
          "productId",
          "packageSize",
          "quantity",
          "price",
          "rationale",
          "confidence"
        ],
        "properties": {
          "ingredientId": { "type": "string", "minLength": 1 },
          "requested": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["added", "already_present", "skipped"]
          },
          "productName": { "type": ["string", "null"] },
          "productId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9]{10}$" },
          "packageSize": { "type": ["string", "null"] },
          "quantity": { "type": "integer", "minimum": 0 },
          "price": { "type": ["string", "null"] },
          "rationale": { "type": "string", "minLength": 1 },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    },
    "verificationNotes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "failureReason": { "type": ["string", "null"] }
  }
}
