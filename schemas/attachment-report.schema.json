{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connected",
    "url",
    "title",
    "navigationPerformed",
    "interactionPerformed",
    "failureReason"
  ],
  "properties": {
    "connected": { "type": "boolean" },
    "url": {
      "type": ["string", "null"],
      "enum": ["https://example.com/", null]
    },
    "title": {
      "type": ["string", "null"],
      "enum": ["Example Domain", null]
    },
    "navigationPerformed": { "type": "boolean" },
    "interactionPerformed": { "type": "boolean" },
    "failureReason": { "type": ["string", "null"] }
  }
}
