{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whole-foods-cart.local/schemas/cart-agent-result.schema.json",
  "title": "Whole Foods Cart Agent result",
  "description": "The single result returned by one Cart Agent invocation handling one ingredient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ingredientId",
    "requested",
    "status",
    "productName",
    "productId",
    "packageSize",
    "quantity",
    "price",
    "rationale",
    "confidence",
    "failureReason"
  ],
  "properties": {
    "ingredientId": { "type": "string", "minLength": 1 },
    "requested": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["added", "already_present", "skipped", "failed"]
    },
    "productName": { "type": ["string", "null"] },
    "productId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9]{10}$" },
    "packageSize": { "type": ["string", "null"] },
    "quantity": { "type": "integer", "minimum": 0 },
    "price": { "type": ["string", "null"] },
    "rationale": { "type": "string", "minLength": 1 },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "failureReason": { "type": ["string", "null"] }
  }
}
