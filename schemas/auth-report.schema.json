{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runStatus",
    "authenticated",
    "deliveryModeConfirmed",
    "deliveryAddressConfirmed",
    "wholeFoodsStorefrontConfirmed",
    "checkoutVisited",
    "settingsChanged",
    "failureReason"
  ],
  "properties": {
    "runStatus": { "type": "string", "enum": ["completed", "failed"] },
    "authenticated": { "type": "boolean" },
    "deliveryModeConfirmed": { "type": "boolean" },
    "deliveryAddressConfirmed": { "type": "boolean" },
    "wholeFoodsStorefrontConfirmed": { "type": "boolean" },
    "checkoutVisited": { "type": "boolean" },
    "settingsChanged": { "type": "boolean" },
    "failureReason": { "type": ["string", "null"] }
  }
}
