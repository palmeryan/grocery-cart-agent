{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whole-foods-cart.local/schemas/shopping-plan.schema.json",
  "title": "Whole Foods meal-plan compiler output",
  "description": "A source-preserving, purchase-oriented plan for autonomous cart execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "recipes", "purchaseIntents", "decisionLog"],
  "properties": {
    "contractVersion": { "type": "integer", "const": 3 },
    "recipes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recipe" } },
    "purchaseIntents": { "type": "array", "items": { "$ref": "#/$defs/purchaseIntent" } },
    "decisionLog": { "type": "array", "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "quantityMax", "unit", "approximate"],
      "properties": {
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "quantityMax": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "approximate": { "type": "boolean" }
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "sourceQuantity", "additiveQuantity"],
      "properties": {
        "raw": { "type": "string" },
        "sourceQuantity": { "anyOf": [{ "$ref": "#/$defs/quantity" }, { "type": "null" }] },
        "additiveQuantity": { "anyOf": [{ "$ref": "#/$defs/quantity" }, { "type": "null" }] }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "guidance"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "guidance": { "type": "string", "minLength": 1 }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "message"],
      "properties": {
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "disposition": { "type": "string", "enum": ["buy", "assume_pantry", "omit_optional"] },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceName", "sourceText", "sourceOccurrence", "componentIndex"],
      "properties": {
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceText": { "type": "string", "minLength": 1 },
        "sourceOccurrence": { "type": "integer", "minimum": 1 },
        "componentIndex": { "type": "integer", "minimum": 1 }
      }
    },
    "recipeLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceText", "sourceOccurrence", "componentIndex", "name", "amount", "preparation", "context", "optional", "pantryStatus", "alternatives", "unresolved", "disposition", "purchaseIntentId"],
      "properties": {
        "sourceText": { "type": "string", "minLength": 1 },
        "sourceOccurrence": { "type": "integer", "minimum": 1 },
        "componentIndex": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "amount": { "$ref": "#/$defs/amount" },
        "preparation": { "type": ["string", "null"] },
        "context": { "type": ["string", "null"] },
        "optional": { "type": "boolean" },
        "pantryStatus": { "type": "string", "enum": ["buy", "assume_pantry", "uncertain"] },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/alternative" } },
        "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } },
        "disposition": { "$ref": "#/$defs/disposition" },
        "purchaseIntentId": { "type": "string", "minLength": 1 }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceName", "ingredients"],
      "properties": {
        "sourceName": { "type": "string", "minLength": 1 },
        "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recipeLine" } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceName", "sourceText", "sourceOccurrence", "componentIndex", "context", "disposition"],
      "properties": {
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceText": { "type": "string", "minLength": 1 },
        "sourceOccurrence": { "type": "integer", "minimum": 1 },
        "componentIndex": { "type": "integer", "minimum": 1 },
        "context": { "type": ["string", "null"] },
        "disposition": { "$ref": "#/$defs/disposition" }
      }
    },
    "purchaseIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primary", "alternatives", "sourceLines", "sourceAmounts", "additiveAmount", "optional", "disposition"],
      "properties": {
        "id": { "type": "string", "pattern": "^intent-[a-f0-9]{16}$" },
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "guidance"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "guidance": { "type": "string", "minLength": 1 }
          }
        },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/alternative" } },
        "sourceLines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "sourceAmounts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/amount" } },
        "additiveAmount": { "anyOf": [{ "$ref": "#/$defs/quantity" }, { "type": "null" }] },
        "optional": { "type": "boolean" },
        "disposition": { "$ref": "#/$defs/disposition" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "code", "message", "sources", "purchaseIntentId"],
      "properties": {
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "code": { "type": "string", "enum": ["consolidated", "incompatible_amounts", "pantry_assumption", "optional_omitted", "unresolved_interpretation"] },
        "message": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "purchaseIntentId": { "type": "string", "pattern": "^intent-[a-f0-9]{16}$" }
      }
    }
  }
}
