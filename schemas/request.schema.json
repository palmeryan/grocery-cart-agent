{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipes"],
  "properties": {
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "servings", "context", "ingredients"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "servings": { "type": "integer", "minimum": 1, "maximum": 20 },
          "context": { "type": "string", "minLength": 1 },
          "ingredients": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "request"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9-]+$"
                },
                "request": { "type": "string", "minLength": 3 },
                "preferences": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
